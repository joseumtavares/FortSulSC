# ==============================================================================
# CONFIGURAÇÃO DE BANCO DE DADOS (POSTGRESQL LOCAL / DOCKER COMPOSE)
# ==============================================================================

# Usuário administrador (owner/superuser) do PostgreSQL no container Docker
POSTGRES_USER=fortsul

# Senha do usuário administrador do PostgreSQL local
POSTGRES_PASSWORD=

# Nome do banco de dados principal criado no PostgreSQL
POSTGRES_DB=fortsul_dev

# Usuário de aplicação com privilégios reduzidos (usado em runtime pela aplicação)
POSTGRES_APP_USER=fortsul_app

# Senha do usuário de aplicação (POSTGRES_APP_USER)
POSTGRES_APP_PASSWORD=


# ==============================================================================
# CONTRATO DE CONEXÃO DO BANCO DE DADOS (LOCAL vs VERCEL + SUPABASE)
# ==============================================================================
#
# CONTRATO:
# 1. A aplicação em runtime SEMPRE consome DATABASE_URL.
# 2. Execuções administrativas e migrations do Prisma SEMPRE consom DATABASE_URL_MIGRATE.
#
# --- MODO 1: DESENVOLVIMENTO LOCAL (DOCKER COMPOSE) ---
# - DATABASE_PLATFORM=local
# - DATABASE_PROVIDER=postgresql
# - DATABASE_URL: O Compose resolve automaticamente ou monta com a role fortsul_app.
# - DATABASE_URL_MIGRATE: Conexão direta com a role fortsul (owner/migrations).
#
# --- MODO 2: PRODUÇÃO (VERCEL + SUPABASE) ---
# - DATABASE_PLATFORM=supabase
# - DATABASE_PROVIDER=postgresql
# - DATABASE_URL: URI do Supabase Connection Pooler (Transaction Mode, porta 6543).
#   Exemplo: postgresql://fortsul_app:[SENHA]@[HOST_POOLER]:6543/postgres?pgbouncer=true
# - DATABASE_URL_MIGRATE: URI de conexão DIRETA do Supabase (Session Mode, porta 5432).
#   Exemplo: postgresql://postgres:[SENHA]@[HOST_DIRETO]:5432/postgres

# Plataforma de hospedagem do banco de dados ('local' para Docker Compose ou 'supabase' para nuvem/Vercel)
DATABASE_PLATFORM=local

# Driver/provedor do banco de dados utilizado pelo Prisma/ORM
DATABASE_PROVIDER=postgresql

# String de conexão do runtime da aplicação:
# - No Local: montada automaticamente pelo Compose ou apontada para a role de runtime (fortsul_app).
# - Na Vercel + Supabase: deve ser a URL do Connection Pooler (porta 6543) com pooling ativado.
DATABASE_URL=

# String de conexão de administração/migrations do Prisma:
# - No Local: aponta para o container do banco Docker usando a role owner (fortsul).
# - Na Vercel + Supabase: deve ser a URL direta sem pooler (porta 5432) para executar DDL/migrations.
DATABASE_URL_MIGRATE=postgresql://fortsul:postgres@db:5432/fortsul_dev


# ==============================================================================
# AUTENTICAÇÃO E SEGURANÇA (LOCAL E PRODUÇÃO / VERCEL)
# ==============================================================================

# URL base da aplicação (no ambiente local: http://localhost:3000; na Vercel: https://seudominio.vercel.app)
AUTH_ORIGIN=http://localhost:3000

# Chave secreta principal usada para assinar tokens JWT e criptografar sessões de login
AUTH_SECRET=

# Chave secreta auxiliar (pepper) para proteger hashes de códigos MFA/acesso temporário e IP
MFA_CODE_PEPPER=

# Permite confiar no header Host da requisição (true para local e proxy reverso da Vercel)
AUTH_TRUST_HOST=true

# Exige HTTPS nos cookies de autenticação (false no desenvolvimento HTTP local; true obrigatoriamente na Vercel/HTTPS)
AUTH_COOKIE_SECURE=false

# Ativa cabeçalho HSTS de segurança estrita em HTTPS (false em desenvolvimento local; true em produção na Vercel)
SECURITY_HEADERS_HSTS=false

# Confia nos cabeçalhos de proxy como X-Forwarded-For (false localmente; true ao rodar atrás do proxy da Vercel)
TRUST_PROXY_HEADERS=false

# Intervalo em segundos para limpeza periódica de sessões e registros de segurança expirados (86400s = 24h)
SECURITY_PURGE_INTERVAL_SECONDS=86400


# ==============================================================================
# SERVIÇO DE E-MAIL (RESEND / NOTIFICAÇÕES)
# ==============================================================================

# Provedor responsável pelo envio de e-mails transacionais (resend em produção/testes, console para debug puro)
EMAIL_PROVIDER=resend

# Chave secreta da API do Resend para envio de e-mails
RESEND_API_KEY=

# Endereço de e-mail do remetente (deve pertencer a um domínio verificado no Resend)
RESEND_FROM_EMAIL=onboarding@resend.dev


# ==============================================================================
# SEED DE USUÁRIO ADMINISTRADOR (TESTES LOCAIS)
# ==============================================================================

# E-mail do usuário administrador padrão gerado no comando de seed
ADMIN_SEED_EMAIL=josetavaresfortsul@gmail.com

# Senha do administrador padrão para testes
ADMIN_SEED_PASSWORD=

# Define se deve forçar a troca da senha do admin caso o registro já exista no seed (manter false)
ADMIN_SEED_RESET_PASSWORD=false
