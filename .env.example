# PostgreSQL — desenvolvimento local, acessível apenas pela rede interna do Compose (db:5432)
# POSTGRES_PASSWORD fica vazio de propósito: preencher no .env local, nunca versionado.
POSTGRES_USER=fortsul
POSTGRES_PASSWORD=
POSTGRES_DB=fortsul_dev

# DATABASE_URL e resolvida dentro do Docker Compose a partir das variaveis acima.
