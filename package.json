{
  "name": "fortsul-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "preview": "node preview.mjs",
    "test:static": "node --test test-preview.mjs",
    "test:unit": "vitest run --exclude 'src/lib/db/**'",
    "test:db": "vitest run src/lib/db",
    "test": "npm run test:static && npm run test:unit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:types": "eslint --config eslint.typed.config.mjs .",
    "dev": "next dev",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "typecheck": "prisma generate && tsc --noEmit",
    "purge:security": "tsx scripts/purge-security-data.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "aws4fetch": "^1.0.20",
    "bcryptjs": "3.0.3",
    "dotenv": "^16.6.1",
    "lucide-react": "^1.43.0",
    "motion": "^13.2.0",
    "next": "^16.2.9",
    "next-auth": "5.0.0-beta.32",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "resend": "6.26.0",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.10.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "jsdom": "^30.0.1",
    "prisma": "^6.19.0",
    "supabase": "^2.116.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "unrs-resolver@1.12.2": true,
    "esbuild@0.28.2": true
  }
}
